{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Beehaven Design Tokens",
  "version": "1.0.0",
  "typography": {
    "fontFamilyUi": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "fontFamilyMono": "'Cascadia Mono', 'Consolas', 'SFMono-Regular', 'JetBrains Mono', ui-monospace, monospace",
    "sizes": {
      "xs": "12px",
      "sm": "13px",
      "base": "14px",
      "lg": "16px",
      "xl": "20px"
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px"
  },
  "radii": {
    "control": "6px",
    "panel": "10px"
  },
  "statusVocabulary": {
    "Queued": { "mark": "○", "label": "Queued", "role": "muted" },
    "Running": { "mark": "◐", "label": "Running", "role": "info" },
    "WaitingForYou": { "mark": "▲", "label": "Waiting for you", "role": "attention" },
    "NeedsReview": { "mark": "◆", "label": "Needs review", "role": "info" },
    "Approved": { "mark": "✓", "label": "Approved", "role": "success" },
    "Merging": { "mark": "⟳", "label": "Merging", "role": "info" },
    "Merged": { "mark": "✔", "label": "Merged", "role": "success" },
    "Failed": { "mark": "✗", "label": "Failed", "role": "danger" },
    "Discarded": { "mark": "⊘", "label": "Discarded", "role": "muted" }
  },
  "themes": {
    "dark": {
      "background": "#0B0E14",
      "surface": "#131822",
      "surfaceElevated": "#1B2230",
      "text": "#F1F5F9",
      "mutedText": "#94A3B8",
      "border": "#6B7C95",
      "accent": "#60A5FA",
      "info": "#38BDF8",
      "attention": "#FBBF24",
      "success": "#4ADE80",
      "danger": "#F87171"
    },
    "light": {
      "background": "#F8FAFC",
      "surface": "#FFFFFF",
      "surfaceElevated": "#F1F5F9",
      "text": "#0F172A",
      "mutedText": "#475569",
      "border": "#64748B",
      "accent": "#1D4ED8",
      "info": "#0369A1",
      "attention": "#B45309",
      "success": "#15803D",
      "danger": "#B91C1C"
    }
  }
}
